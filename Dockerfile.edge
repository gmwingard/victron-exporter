# Multi-stage build used by the `edge` workflow (pushes to main).
# Tagged releases use the top-level `Dockerfile` via goreleaser.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/victron-exporter .

FROM alpine:3.20
COPY --from=build /out/victron-exporter /usr/local/bin/victron-exporter
ENTRYPOINT ["/usr/local/bin/victron-exporter"]
